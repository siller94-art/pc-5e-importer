{
  "id": "pc-5e-importer",
  "title": "PC 5/5.5e Importer",
  "description": "Import player characters into the D&D 5e system from a PDF character sheet, pasted text, or a step-by-step picker, then level them up. Handles species, backgrounds, classes, subclasses, feats, equipment, spells and traits for both 2014 and 2024 rules.",
  "version": "1.2.2",
  "authors": [
    {
      "name": "siller94-art",
      "url": "https://github.com/siller94-art"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.3.0"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/pc-importer.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
